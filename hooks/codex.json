{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/session-start.sh\" codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/hook.sh\" session-start codex",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/hook.sh\" prompt codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/hook.sh\" stop codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
